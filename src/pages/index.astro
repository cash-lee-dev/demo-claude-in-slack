---
import BaseLayout from '../layouts/BaseLayout.astro';
import Screen from '../components/Screen.astro';
import { url } from '../data/site';
---

<!--
  CTCC-13 示範首頁：只用來驗證整頁切換引擎與共用版型。
  正式首頁設計由 CTCC-14 取代（保留 <Screen> 的用法即可）。
-->
<BaseLayout>
  <Screen id="hero" label="首屏">
    <div class="orbit" aria-hidden="true" data-enter="fade" data-depth="0.4">
      <i></i><i></i><i></i><b></b>
    </div>
    <div class="stack-lg hero">
      <p class="eyebrow" data-enter>May4s 伊原力科技</p>
      <h1 class="display" data-split="chars">企業 Agentic OS</h1>
      <p class="lead" data-split="lines">
        以 Salesforce、Slack 與 Agentforce，讓人與 AI 代理人在同一個工作空間協作，把企業營運變成會自己運轉的系統。
      </p>
      <div class="row" data-enter>
        <a class="btn btn--primary" href={url('/solutions/')} data-magnetic>探索解決方案 <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={url('/contact/')} data-magnetic>聯絡我們</a>
      </div>
      <p class="chip" data-enter="fade"><i></i>Foundation demo · 版型驗證用，正式內容見 CTCC-14</p>
    </div>
    <p class="scroll-hint" data-enter="fade" aria-hidden="true"><span></span>SCROLL</p>
  </Screen>

  <Screen id="capabilities" label="核心能力">
    <div class="stack-lg">
      <p class="eyebrow" data-enter>Capabilities</p>
      <h2 class="h2" data-split="lines">三個平台，一個協作的大腦</h2>
      <div class="grid-3">
        <article class="card" data-enter data-depth="1.2">
          <h3 class="h3">Salesforce</h3>
          <p class="muted">以客戶為中心的銷售、服務與行銷（佔位內容）。</p>
        </article>
        <article class="card" data-enter data-depth="1.6">
          <h3 class="h3">Slack</h3>
          <p class="muted">團隊、資料與流程集中在同一個頻道（佔位內容）。</p>
        </article>
        <article class="card" data-enter data-depth="2">
          <h3 class="h3">Agentforce</h3>
          <p class="muted">能理解情境、主動行動的 AI 代理人（佔位內容）。</p>
        </article>
      </div>
    </div>
  </Screen>

  <Screen id="solutions" label="解決方案">
    <div class="stack-lg">
      <p class="eyebrow" data-enter>Solutions</p>
      <h2 class="h2" data-split="lines">從產業場景到軟體平台</h2>
      <p class="lead" data-split="lines">七個解決方案涵蓋製造電商、售後服務、通路管理，以及 Salesforce、Slack 等核心平台（佔位內容）。</p>
      <div class="row" data-enter>
        <span class="chip"><i></i>客製化製造電商</span>
        <span class="chip"><i></i>售後服務管理</span>
        <span class="chip"><i></i>經銷商與代理商管理</span>
        <span class="chip"><i></i>Salesforce CRM</span>
        <span class="chip"><i></i>Slack</span>
      </div>
      <div class="row" data-enter>
        <a class="btn btn--primary" href={url('/solutions/')} data-magnetic>查看全部解決方案 <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </Screen>

  <Screen id="principles" label="為什麼是我們">
    <div class="stack-lg">
      <p class="eyebrow" data-enter>Why May4s</p>
      <h2 class="h2" data-split="lines">把複雜留給我們，把流暢留給團隊</h2>
      <div class="grid-3">
        <div class="stack" data-enter data-depth="1.2"><p class="num">01</p><h3 class="h3">顧問 × 實作</h3><p class="muted">同一個團隊從需求訪談做到上線與維運（佔位內容）。</p></div>
        <div class="stack" data-enter data-depth="1.6"><p class="num">02</p><h3 class="h3">資安優先</h3><p class="muted">以 ISO 27001 的標準管理每一份客戶資料（佔位內容）。</p></div>
        <div class="stack" data-enter data-depth="2"><p class="num">03</p><h3 class="h3">AI 就緒</h3><p class="muted">資料與流程先整理好，AI 代理人才跑得穩（佔位內容）。</p></div>
      </div>
    </div>
  </Screen>

  <Screen id="cta" label="開始對話">
    <div class="stack-lg">
      <p class="eyebrow" data-enter>Let's talk</p>
      <h2 class="h2" data-split="lines">準備好打造你的 Agentic OS 了嗎？</h2>
      <div class="row" data-enter>
        <a class="btn btn--primary" href={url('/contact/')} data-magnetic>預約諮詢 <span class="btn__arrow" aria-hidden="true">→</span></a>
        <a class="btn" href={url('/solutions/')} data-magnetic>先看解決方案</a>
      </div>
    </div>
  </Screen>
</BaseLayout>
