---
/**
 * 全站固定背景：CSS 星雲 + CSS 星空（首屏 / 無 WebGL 退路）+ Three.js canvas（idle 後才載入）。
 * 以 transition:persist 保留，換頁時 DOM 節點不重建、canvas 不閃爍。
 * 控制邏輯在 src/scripts/starfield.ts。
 */
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(77);
const palette = ['#ffffff', '#dff3ff', '#bfe6f7', '#8fd3f0', '#55bde9', '#ffd400'];
function layer(n: number, yellowRate: number) {
  return Array.from({ length: n }, () => {
    const c = rand() < yellowRate ? palette[5] : palette[Math.floor(rand() * 5)];
    return `${(rand() * 100).toFixed(2)}vw ${(rand() * 100).toFixed(2)}vh 0 0 ${c}`;
  }).join(',');
}
const l1 = layer(150, 0.02);
const l2 = layer(48, 0.06);
const l3 = layer(14, 0.2);
---

<div id="starfield" class="starfield" aria-hidden="true" data-starfield="pending" transition:persist="starfield">
  <!-- .sf-px 是滑鼠視差用的外層（GSAP 寫 transform）；內層才有 CSS 動畫 / 縮放，兩者不互相覆蓋 -->
  <div class="sf-px" data-px="14"><span class="sf-n1"></span></div>
  <div class="sf-px" data-px="-22"><span class="sf-n2"></span></div>
  <div class="sf-px"><span class="sf-n3"></span></div>
  <div class="sf-px" data-px="8"><div class="sf-band"></div></div>
  <div class="sf-px" data-px="5">
    <div class="sf-css">
      <i style={`box-shadow:${l1}`}></i>
      <i style={`box-shadow:${l2}`}></i>
      <i style={`box-shadow:${l3}`}></i>
    </div>
  </div>
  <canvas class="sf-canvas"></canvas>
  <div class="sf-warp-glow"></div>
  <div class="sf-vignette"></div>
</div>
