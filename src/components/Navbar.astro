---
import { contactLink, industrySolutions, navLinks, softwareSolutions, solutionHref, url, SITE_NAME } from '../data/site';
const path = Astro.url.pathname;
const onSolutions = path.startsWith(url('/solutions/'));
const onContact = path.startsWith(url('/contact/'));
---

<header class="site-nav" data-nav>
  <a class="site-nav__brand" href={url('/')} aria-label={`${SITE_NAME}，回首頁`} data-magnetic="0.25">
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path d="M16 1.5c.9 7.7 4.7 13.1 14.5 14.5-9.8 1.4-13.6 6.8-14.5 14.5C15.100 22.800 11.300 17.400 1.500 16 11.300 14.600 15.100 9.200 16 1.500Z" fill="#ffd400"></path>
      <circle cx="16" cy="16" r="3" fill="#030712"></circle>
    </svg>
    <span>May4s <small>伊原力科技</small></span>
  </a>

  <button class="site-nav__toggle" type="button" aria-label="開啟選單" aria-expanded="false" aria-controls="site-menu">
    <span></span>
  </button>

  <nav class="site-nav__menu" id="site-menu" aria-label="主選單">
    <ul class="site-nav__list">
      <li class="has-dropdown">
        <button class="nav-link" type="button" aria-expanded="false" aria-controls="nav-solutions" aria-haspopup="true" aria-current={onSolutions ? 'page' : undefined}>
          解決方案
          <svg viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </button>
        <div class="nav-dropdown" id="nav-solutions" data-no-screen-keys>
          <div class="nav-dropdown__group">
            <p class="nav-dropdown__title">產業解決方案</p>
            {industrySolutions.map((s) => (
              <a class="nav-dropdown__item" href={solutionHref(s.id)}>
                <strong>{s.label}</strong>
                <span>{s.desc}</span>
              </a>
            ))}
          </div>
          <div class="nav-dropdown__group">
            <p class="nav-dropdown__title">軟體與平台</p>
            {softwareSolutions.map((s) => (
              <a class="nav-dropdown__item" href={solutionHref(s.id)}>
                <strong>{s.label}</strong>
                <span>{s.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </li>
      {navLinks.map((l) => (
        <li>
          <a class="nav-link" href={l.href} rel={l.external ? 'noopener' : undefined}>{l.label}</a>
        </li>
      ))}
      <li>
        <a class="btn btn--primary btn--sm site-nav__cta" href={contactLink.href} data-magnetic aria-current={onContact ? 'page' : undefined}>{contactLink.label}</a>
      </li>
    </ul>
  </nav>
</header>
