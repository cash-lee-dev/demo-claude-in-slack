# ---------------------------------------------------------------
# 複製成 .env（或 .env.local）後填入自己的值。.env 已被 .gitignore 忽略，請勿提交。
# 注意：VITE_ 開頭的變數會被打包進前端 bundle，任何人都看得到（本專案刻意忽略資安）。
# ---------------------------------------------------------------

# 用來對密碼做 HMAC-SHA-256 的 hash key（任意長字串）
VITE_AUTH_HASH_KEY=change-me-to-a-long-random-string

# 管理員帳號
VITE_ADMIN_USERNAME=admin

# 管理員密碼（執行時會用 hash key 算出 hash 再比對，程式不會做明文比較）
VITE_ADMIN_PASSWORD=change-me-password

# （選填）額外使用者：JSON 陣列，passwordHash 為 HMAC-SHA-256(hashKey, password) 的 hex。
# 產生 hash：npm run hash -- <password>（會讀取上面的 VITE_AUTH_HASH_KEY）
# VITE_EXTRA_USERS=[{"username":"neo","passwordHash":"<hex>","role":"operator"}]

# （選填）部署的 base path。build 預設 /demo-claude-in-slack/，dev 預設 /
# VITE_BASE_PATH=/demo-claude-in-slack/
