# ---------------------------------------------------------------
# 複製成 .env（或 .env.local）後填入自己的值。.env 已被 .gitignore 忽略，請勿提交。
# 注意：VITE_ 開頭的變數會被打包進前端 bundle，任何人都看得到（本專案刻意忽略資安）。
# ---------------------------------------------------------------

# 用來對密碼做 HMAC-SHA-256 的 hash key（任意長字串）
VITE_AUTH_HASH_KEY=change-me-to-a-long-random-string

# 管理員帳號
VITE_ADMIN_USERNAME=admin

# 管理員密碼的 hash（建議用法）：HMAC-SHA-256(VITE_AUTH_HASH_KEY, 密碼) 的 hex。
# 產生方式（兩種擇一，結果相同；hash key 必須與上面的 VITE_AUTH_HASH_KEY 一致）：
#   1) npm run hash -- '<password>'        （會自動讀取 .env 的 VITE_AUTH_HASH_KEY）
#   2) printf '%s' '<password>' | openssl dgst -sha256 -hmac '<hash key>' | sed 's/^.*= //'
#      openssl 輸出會帶 "SHA2-256(stdin)= " 之類的前綴（依版本不同），sed 會把它去掉，只留 64 字元 hex。
# 範例值（對應 key=change-me-to-a-long-random-string、密碼=change-me-password）：
VITE_ADMIN_PASSWORD_HASH=af4206164211aeffa86878adede9816a582d202e5ec6449ce68f3309a0de8cba

# （選填，備援）管理員明文密碼：只有在沒有設定 VITE_ADMIN_PASSWORD_HASH 時才會使用，
# 執行時才用 hash key 算出 hash 再比對。建議改用上面的 hash。
# VITE_ADMIN_PASSWORD=change-me-password

# （選填）額外使用者：JSON 陣列，passwordHash 為 HMAC-SHA-256(hashKey, password) 的 hex。
# 產生 hash 的方式同上。
# VITE_EXTRA_USERS=[{"username":"neo","passwordHash":"<hex>","role":"operator"}]

# （選填）部署的 base path。build 預設 /demo-claude-in-slack/，dev 預設 /
# VITE_BASE_PATH=/demo-claude-in-slack/
